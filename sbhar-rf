"text/plain":["<Figure size 1000x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["# ==========================================\n","# 5. EXECUÇÃO DO PIPELINE\n","# ==========================================\n","\n","# 1. Carregar\n","X_train_full, y_train_full, X_val_full, y_val_full, X_test_full, y_test_full = load_data(DATASET_PATH)\n","\n","if X_train_full is not None:\n","\n","    results = []\n","    scenarios = [\n","        (\"Raw Data\", prep_data_raw, False),        # 1. Raw + Default\n","        (\"Feature Eng\", prep_data_features, False),# 2. Feat + Default\n","        (\"Raw + Optuna\", prep_data_raw, True),     # 3. Raw + Optuna\n","        (\"Feat + Optuna\", prep_data_features, True)# 4. Feat + Optuna\n","    ]\n","\n","    for name, prep_func, use_optuna in scenarios:\n","        print(f\"\\n>>> INICIANDO CENÁRIO: {name} <<<\")\n","\n","        # A. Preparação dos Dados\n","        X_tr = prep_func(X_train_full)\n","        X_va = prep_func(X_val_full)\n","        X_te = prep_func(X_test_full)\n","        print(f\"   Shape de Entrada: {X_tr.shape}\")\n","\n","        # B. Definição do Modelo\n","        if use_optuna:\n","            # Roda o Optuna com 50 trials\n","            best_params = run_optuna(X_tr, y_train_full, X_va, y_val_full, n_trials=50)\n","\n","            model = RandomForestClassifier(**best_params, n_jobs=-1, random_state=SEED)\n","        else:\n","            print(\"    Usando Hiperparâmetros Default\")\n","            model = RandomForestClassifier(n_estimators=100, n_jobs=-1, random_state=SEED)\n","\n","        # C. Treinamento\n","        print(\"   Training...\")\n","        model.fit(X_tr, y_train_full)\n","\n","        # D. Previsão Base (para a Matriz de Confusão)\n","        y_pred = model.predict(X_te)\n","\n","        # E. Plot da Matriz de Confusão\n","        # Normalizando por linha (true class) para lidar com o desbalanceamento\n","        cm = confusion_matrix(y_test_full, y_pred, normalize='true')\n","        plt.figure(figsize=(8, 6))\n","        # fmt='.2f' para exibir floats formatados com 2 casas decimais\n","        sns.heatmap(cm, annot=True, fmt='.2f', cmap='Blues')\n","        plt.title(f'Matriz de Confusão Normalizada - {name}')\n","        plt.ylabel('Classe Verdadeira')\n","        plt.xlabel('Classe Predita')\n","        plt.show()\n","\n","        # F. Avaliação (Bootstrap - Substitui avaliação de Literatura isolada)\n","        f1_m, f1_l, f1_u, acc_m, acc_l, acc_u = bootstrap_eval(model, X_te, y_test_full)\n","        print(f\"   [Bootstrap] F1-Mean: {f1_m:.4f} (IC 95%: {f1_l:.4f} - {f1_u:.4f})\")\n","        print(f\"   [Bootstrap] Acc-Mean: {acc_m:.4f} (IC 95%: {acc_l:.4f} - {acc_u:.4f})\")\n","\n","        # G. Salvar Resultados\n","        results.append({\n","            \"Scenario\": name,\n","            \"F1_Mean\": f1_m,\n","            \"F1_Lower\": f1_l,\n","            \"F1_Upper\": f1_u,\n","            \"Acc_Mean\": acc_m,\n","            \"Acc_Lower\": acc_l,\n","            \"Acc_Upper\": acc_u\n","        })\n","\n","        # H. Limpeza de Memória\n","        del X_tr, X_va, X_te, model\n","        gc.collect()\n","\n","    # ==========================================\n","    # 6. RELATÓRIO FINAL\n","    # ==========================================\n","    df_res = pd.DataFrame(results)\n","    print(\"\\n\\n=== RELATÓRIO FINAL (BOOTSTRAP - F1 & ACC) ===\")\n","    display(df_res)\n","\n","    # Preparar dados para o histograma azul\n","    df_melted = df_res.melt(\n","        id_vars='Scenario',\n","        value_vars=['F1_Mean', 'Acc_Mean'],\n","        var_name='Metric',\n","        value_name='Score'\n","    )\n","\n","    # Plotagem - Histograma Azul\n","    plt.figure(figsize=(10, 6))\n","    # Utilizamos tons de azul explícitos\n","    sns.barplot(data=df_melted, x='Scenario', y='Score', hue='Metric', palette=['#1f77b4', '#aec7e8'])\n","\n","    plt.title(\"Comparação de Desempenho (Média Bootstrap) - F1-Score vs Acurácia\")\n","    plt.ylabel(\"Score\")\n","    plt.ylim(0.0, 1.05)\n","    plt.legend(title='Métrica')\n","    plt.grid(axis='y', linestyle='--', alpha=0.7)\n","    plt.show()\n"]}]}