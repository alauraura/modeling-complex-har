e o caminho.\")\n","        return None, None, None, None, None, None\n"],"metadata":{"id":"mA4_b0Bhlj8i","executionInfo":{"status":"ok","timestamp":1776666009861,"user_tz":180,"elapsed":42,"user":{"displayName":"Laura Colombo","userId":"01992076638867357951"}}},"execution_count":5,"outputs":[]},{"cell_type":"code","source":["# ==========================================\n","# 2. FEATURE ENGINEERING & PRE-PROCESSING\n","# ==========================================\n","\n","def prep_data_raw(X):\n","    \"\"\"\n","    Cenário 1 & 3: RAW DATA\n","    Estratégia: Flattening (Achatamento)\n","    Transforma matriz (128, 6) em vetor (768,)\n","    \"\"\"\n","    N, T, F = X.shape\n","    return X.reshape(N, T * F)\n","\n","def prep_data_features(X):\n","    \"\"\"\n","    Cenário 2 & 4: FEATURE ENGINEERING\n","    Estratégia: Extração de Estatísticas (Mean, Std, Max, Min)\n","    Reduz a dimensionalidade e foca em características do sinal.\n","    \"\"\"\n","    # Média e Desvio por eixo\n","    feat_mean = np.mean(X, axis=1)\n","    feat_std  = np.std(X, axis=1)\n","    feat_max  = np.max(X, axis=1)\n","    feat_min  = np.min(X, axis=1)\n","\n","    # Concatena: (N, 6) + (N, 6) + (N, 6) + (N, 6) = (N, 24)\n","    return np.hstack([feat_mean, feat_std, feat_max, feat_min])"],"metadata":{"id":"4gaIeB-9lny3","executionInfo":{"status":"ok","timestamp":1776666009900,"user_tz":180,"elapsed":8,"user":{"displayName":"Laura Colombo","userId":"01992076638867357951"}}},"execution_count":6,"outputs":[]},{"cell_type":"code","source":["# ==========================================\n","# 3. OPTUNA - OTIMIZAÇÃO DE HIPERPARÂMETROS\n","# ==========================================\n","\n","def objective_rf(trial, X_tr, y_tr, X_val, y_val):\n","    # Espaço de busca\n","    n_estimators = trial.suggest_int('n_estimators', 100, 1000)\n","\n","    # Lógica para max_depth: [10, 50] ou None\n","    if trial.suggest_categorical('max_depth_is_none', [True, False]):\n","        max_depth = None\n","    else:\n","        max_depth = trial.suggest_int('max_depth', 10, 50)\n","\n","    min_samples_split = trial.suggest_int('min_samples_split', 2, 20)\n","    min_samples_leaf = trial.suggest_int('min_samples_leaf', 1, 10)\n","\n","    # Sugestões Categóricas adicionadas\n","    max_features = trial.suggest_categorical('max_features', ['sqrt', 'log2', None])\n","    class_weight = trial.suggest_categorical('class_weight', ['balanced', 'balanced_subsample', None])\n","\n","    model = RandomForestClassifier(\n","        n_estimators=n_estimators,\n","        max_depth=max_depth,\n","        min_samples_split=min_samples_split,\n","        min_samples_leaf=min_samples_leaf,\n","        max_features=max_features,\n","        class_weight=class_weight,\n","        n_jobs=-1,\n","        random_state=SEED\n","    )\n","\n","    model.fit(X_tr, y_tr)\n","    preds = model.predict(X_val)\n","    return f1_score(y_val, preds, average='macro')\n","\n","def run_optuna(X_tr, y_tr, X_val, y_val, n_trials=50):\n","    print(f\"  Rodando Optuna ({n_trials} trials)...\")\n","\n","    # Fixando a semente para garantir reprodutibilidade total no Optuna\n","    sampler = optuna.samplers.TPESampler(seed=SEED)\n","    study = optuna.create_study(direction='maximize', sampler=sampler)\n","\n","    study.optimize(lambda trial: objective_rf(trial, X_tr, y_tr, X_val, y_val), n_trials=n_trials)\n","\n","    print(f\"      Melhores Params: {study.best_params}\")\n","\n","    # Processa os melhores parâmetros para resolver a lógica do max_depth\n","    best_params = study.best_params.copy()\n","    if best_params.pop('max_depth_is_none', False):\n","        best_params['max_depth'] = None\n","\n","    return best_params\n"],"metadata":{"id":"k70vPPcllq4y","executionInfo":{"status":"ok","timestamp":1776666009937,"user_tz":180,"elapsed":31,"user":{"displayName":"Laura Colombo","userId":"01992076638867357951"}}},"execution_count":7,"outputs":[]},{"cell_type":"code","source":["# ==========================================\n","# 4. AVALIAÇÃO (BOOTSTRAP)\n","# ==========================================\n","\n","def bootstrap_eval(model, X_test, y_test, n_iterations=1000):\n","    \"\"\"\n","    Realiza Bootstrap no conjunto de teste para gerar Intervalo de Confiança\n","    para F1-Score (Macro) e Acurácia.\n","    \"\"\"\n","    f1_scores = []\n","    acc_scores = []\n","    n_size = len(y_test)\n","\n","    print(f\" Calculando Bootstrap ({n_iterations} iterações)...\")\n","    for i in range(n_iterations):\n","        # Amostragem com reposição\n","        indices = np.random.randint(0, n_size, n_size)\n","        X_sample = X_test[indices]\n","        y_sample = y_test[indices]\n","\n","        pred = model.predict(X_sample)\n","\n","        f1 = f1_score(y_sample, pred, average='macro')\n","        acc = accuracy_score(y_sample, pred)\n","\n","        f1_scores.append(f1)\n","        acc_scores.append(acc)\n","\n","    alpha = 0.95\n","    p = ((1.0 - alpha) / 2.0) * 100\n","\n","    f1_lower = np.percentile(f1_scores, p)\n","    f1_upper = np.percentile(f1_scores, 100 - p)\n","    f1_mean = np.mean(f1_scores)\n","\n","    acc_lower = np.percentile(acc_scores, p)\n","    acc_upper = np.percentile(acc_scores, 100 - p)\n","    acc_mean = np.mean(acc_scores)\n","\n","    return f1_mean, f1_lower, f1_upper, acc_mean, acc_lower, acc_upper\n"],"metadata":{"id":"lfHWwTGvltuX","executionInfo":{"status":"ok","timestamp":1776666009972,"user_tz":180,"elapsed":8,"user":{"displayName":"Laura Colombo","userId":"01992076638867357951"}}},"execution_count":8,"outputs":[]},{"cell_type":"code","execution_count":9,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"SKupYwm0i3Z4","executionInfo":{"status":"ok","timestamp":1776698564555,"user_tz":180,"elapsed":24145268,"user":{"displayName":"Laura Colombo","userId":"01992076638867357951"}},"outputId":"12b59762-b61e-4b80-bde6-48afb2e55cf9"},"outputs":[{"metadata":{"tags":null},"name":"stdout","outpu